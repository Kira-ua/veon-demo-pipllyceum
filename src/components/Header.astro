---
import FutureLink from "./FutureLink.astro";
import { NAV, PHONE_DISPLAY, PHONE_HREF, EMAIL, EMAIL_HREF, SOON } from "../data/site";
---
<header class="site-header" data-rec="R-104,R-112">
  <div class="container site-header__row">
    <a class="brand" href="#top" aria-label="PIPL Lyceum — на початок сторінки">
      <img src={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}brand/pipl-lyceum.svg`} alt="" width="117" height="77" class="brand__logo" />
    </a>
    <img src={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}brand/ib-world-school.svg`} alt="IB World School" width="121" height="119" class="brand__ib" />

    <nav class="nav" aria-label="Головне меню">
      <ul class="nav__list" role="list">
        {NAV.map((n) => <li><a class="nav__link" href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-header__actions">
      <FutureLink note={SOON} class="lang">EN</FutureLink>
      <a class="header-phone" href={PHONE_HREF}>{PHONE_DISPLAY}</a>
      <a class="btn btn--primary btn--sm header-cta" href={PHONE_HREF}>Екскурсія</a>
      <a class="icon-btn call-btn" href={PHONE_HREF} aria-label={`Подзвонити: ${PHONE_DISPLAY}`} data-rec="R-102">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>
      </a>
      <button class="icon-btn burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Відкрити меню">
        <span class="burger__lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Меню">
      <ul class="mobile-menu__list" role="list">
        {NAV.map((n) => <li><a class="mobile-menu__link" href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="mobile-menu__contacts">
      <a class="btn btn--primary btn--block" href={PHONE_HREF}>Записатися на екскурсію</a>
      <a class="mobile-menu__phone" href={PHONE_HREF}>{PHONE_DISPLAY}</a>
      <a class="text-link" href={EMAIL_HREF}>{EMAIL}</a>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".burger");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Закрити меню" : "Відкрити меню");
      menu.hidden = !open;
      if (open) menu.querySelector<HTMLElement>("a")?.focus();
    };
    btn.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>("a");
      if (!link) return;
      const hash = link.getAttribute("href") ?? "";
      const target = hash.startsWith("#") ? document.getElementById(hash.slice(1)) : null;
      setOpen(false);
      if (!target) return;
      // Close the menu first, then scroll in the next frame so scroll-margin-top under the sticky header applies.
      e.preventDefault();
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";
      requestAnimationFrame(() => {
        const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
        target.scrollIntoView({ behavior: smooth ? "smooth" : "auto", block: "start" });
        history.pushState(null, "", hash);
      });
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") { setOpen(false); btn.focus(); }
    });
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (m) => { if (m.matches) setOpen(false); });
  }
</script>
